# ---------- LLM provider ----------
# One of: ollama | groq | gemini | deepseek | grok
LLM_PROVIDER=ollama
# If the provider above fails (no key, wrong key, rate limit / daily quota, network down),
# answer with this one instead. Leave empty to disable.
LLM_FALLBACK=ollama
# After a rate-limit or bad-key error, skip the primary for this many seconds
LLM_FALLBACK_COOLDOWN=60

# Ollama (local, free, no key: https://ollama.com). First: ollama pull gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# Groq (free tier, no card: https://console.groq.com/keys). Fast; good choice with LLM_FALLBACK=ollama
GROQ_API_KEY=
# llama-3.3-70b-versatile was retired from the free tier on 2026-08-16
GROQ_MODEL=openai/gpt-oss-120b

# Other hosted alternatives (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
XAI_API_KEY=
XAI_MODEL=grok-3-mini
# seconds between hosted-API calls (free-tier rate limits); ignored for ollama. Groq: 2 is enough
LLM_MIN_INTERVAL=2

# ---------- Embeddings (local, free) ----------
# multilingual-e5-base = 768 dims | multilingual-e5-small = 384 | BAAI/bge-m3 = 1024
# If you change the model's dimension, drop the tables first (they're created with this size).
EMBED_MODEL=intfloat/multilingual-e5-base
EMBED_DIM=768

# ---------- Postgres + pgvector (docker compose) ----------
DATABASE_URL=postgresql://rag:rag@localhost:55432/rag
COLLECTION=main

# ---------- Retrieval ----------
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---------- Reranker (optional, local) ----------
# A cross-encoder re-scores the top RERANK_CANDIDATES hits. More accurate ranking, slower answers.
# bge-reranker-v2-m3: multilingual incl. Hindi, ~2.3 GB download, ~3-8 s per question on CPU.
# Lighter alternative (~0.5 GB, much faster; Hindi quality not benchmarked here):
#   RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=20
RERANK_MAX_LENGTH=512                  # tokens per pair; 256-384 is much faster on CPU
RERANK_MIN_SCORE=0.05                  # below this the reranker is "unsure": keep the original order

# ---------- OCR for scanned PDFs ----------
OCR_ENABLED=true
# English model first reads digits in dates/order numbers far better (see README)
OCR_LANG=eng+hin
# Windows, if tesseract isn't on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
